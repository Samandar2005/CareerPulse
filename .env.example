# ===================================
# APP CONFIGURATION
# ===================================
PROJECT_NAME="CareerPulse API"
API_V1_STR="/api/v1"
DEBUG=True

# ===================================
# SECURITY & AUTHENTICATION
# ===================================
# Generatsiya qilish uchun: openssl rand -hex 32
SECRET_KEY="your_super_secret_key_change_this_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===================================
# LOCAL FILE STORAGE
# ===================================
LOCAL_STORAGE_DIR="storage/documents"

# ===================================
# POSTGRESQL + PGVECTOR DATABASE
# Note: Local dev (without Docker) -> POSTGRES_SERVER=localhost
# Docker Compose environment        -> POSTGRES_SERVER=db
# ===================================
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=career_db

# ===================================
# REDIS & CELERY BROKER
# Note: Local dev (without Docker) -> REDIS_HOST=localhost
# Docker Compose environment        -> REDIS_HOST=redis
# ===================================
REDIS_HOST=redis
REDIS_PORT=6379

# ===================================
# AI PROVIDERS (JINA AI & GROQ)
# ===================================
# Jina AI Embeddings v3
JINA_API_KEY="your_jina_api_key_here"
JINA_EMBEDDING_MODEL="jina-embeddings-v3"
JINA_EMBEDDING_DIMENSION=1024
JINA_PASSAGE_TASK="retrieval.passage"
JINA_QUERY_TASK="retrieval.query"

# Groq LLM
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"